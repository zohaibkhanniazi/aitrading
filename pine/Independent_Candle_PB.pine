// Independent Candle Pullback (red / sell scenario) -- part of zohaibkhanniazi/aitrading
// 1 = independent candle: has its own high and low. Candles inside its range are ignored.
// 2 = red candle that comes out of candle 1 (closes beyond / takes its low) -> pullback candidate.
// 3 = first candle that is not inside candle 2: takes candle 2's HIGH (sweep or close above)
//     without taking its LOW -> valid pullback. (Taking the low, or both, = not valid.)
// 4 = a candle closes below candle 2's low -> SELL.
// Cancelled if a candle closes above the pullback high, or after N candles. Newest valid pullback wins.
// Trade (same as the MT5 bot strategies/indep_pb): entry = close of candle 4 (bot: next open),
//   stop = pullback high (highest high from candle 3 to candle 4), target = RR x stop distance.
//@version=5
indicator("Independent Candle Pullback (red scenario)", shorttitle = "Indep PB", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 500)

needLowBreak = input.bool(true, "Candle 2 must go below candle 1's low")
needGreen    = input.bool(true, "Candle 3 must be green")
greyInside   = input.bool(true, "Grey out inside candles (ignored)")
expiry       = input.int(30, "Valid pullback expires after (candles)", minval = 1)
showLines    = input.bool(true, "Lines: candle 2 low and pullback high")
cInd         = input.color(#2962FF, "Independent candle (1)")
cSell        = input.color(#F23645, "Pullback / sell colour")
rr           = input.float(2.0, "Target (R multiple)", minval = 0.5, step = 0.5, group = "Trade")
showTrades   = input.bool(true, "Draw entry / stop / target", group = "Trade")
showStats    = input.bool(true, "Results table", group = "Trade")

type Trade
    float entry
    float sl
    float tp
    int   bar
    line  le
    line  ls
    line  lt
    label lb

type Stats
    int   trades = 0
    int   wins = 0
    int   losses = 0
    float netR = 0.0

var array<Trade> trades = array.new<Trade>()
var Stats stats = Stats.new()

// ---------- current independent (reference) candle
var float refH   = na
var float refL   = na
var int   refBar = na
bool inside = not na(refH) and high <= refH and low >= refL

// ---------- candidate candle 2 (red, out of candle 1)
var bool  cAct = false
var float cH   = na
var float cL   = na
var int   cBar = na
var float mH   = na
var float mL   = na
var int   mBar = na

// ---------- valid pullback waiting for candle 4
var bool  vAct  = false
var float vLow  = na
var float vHigh = na
var int   vBar3 = na
var line  lnLow  = na
var line  lnHigh = na

bool sell = false

// A. candle 4: close below candle 2's low (checked on every candle)
if vAct
    if close < vLow
        sell := true
        vAct := false
        if showLines
            line.set_x2(lnLow, bar_index)
            line.set_x2(lnHigh, bar_index)
        float e  = close
        float sl = math.max(vHigh, high)
        float tp = e - rr * (sl - e)
        string txt = "4 SELL\nEntry " + str.tostring(e, format.mintick) + "\nSL " + str.tostring(sl, format.mintick) + "  (pullback high)\nTP " + str.tostring(tp, format.mintick) + "  (" + str.tostring(rr) + "R)"
        label lb = label.new(bar_index, sl, txt, style = label.style_label_down, color = cSell, textcolor = color.white, size = size.small)
        if showTrades and sl > e
            line le = line.new(bar_index, e, bar_index + 1, e, color = color.new(#2962FF, 0), width = 2)
            line ls = line.new(bar_index, sl, bar_index + 1, sl, color = cSell, width = 2)
            line lt = line.new(bar_index, tp, bar_index + 1, tp, color = color.new(#089981, 0), width = 2)
            array.push(trades, Trade.new(e, sl, tp, bar_index, le, ls, lt, lb))
            stats.trades := stats.trades + 1
        alert("SELL " + syminfo.ticker + " " + timeframe.period + "  entry " + str.tostring(e, format.mintick) + "  SL " + str.tostring(sl, format.mintick) + "  TP " + str.tostring(tp, format.mintick), alert.freq_once_per_bar_close)
    else if close > vHigh or bar_index - vBar3 > expiry
        vAct := false
        if showLines
            line.set_x2(lnLow, bar_index)
            line.set_x2(lnHigh, bar_index)
            line.set_color(lnLow, color.new(color.gray, 50))
            line.set_color(lnHigh, color.new(color.gray, 50))
    else
        vHigh := math.max(vHigh, high)
        if showLines
            line.set_x2(lnLow, bar_index)
            line.set_x2(lnHigh, bar_index)

// B. only candles with their own high/low (not inside the independent candle) build the pattern
if not inside
    // candle 3: first candle out of candle 2
    if cAct
        bool tH = high > cH
        bool tL = low < cL
        if tH and not tL and (not needGreen or close > open)
            // valid pullback -> replaces any older one (latest scenario)
            if vAct and showLines
                line.set_x2(lnLow, bar_index)
                line.set_x2(lnHigh, bar_index)
                line.set_color(lnLow, color.new(color.gray, 50))
                line.set_color(lnHigh, color.new(color.gray, 50))
            vAct  := true
            vLow  := cL
            vHigh := high
            vBar3 := bar_index
            // candle 1's range (blue) from candle 1 up to candle 2 = the zone where inside candles were ignored
            box.new(mBar, mH, cBar, mL, border_color = cInd, border_width = 2, bgcolor = color.new(cInd, 85))
            label.new(mBar, mL, "1", style = label.style_label_up, color = cInd, textcolor = color.white, size = size.small)
            // candle 2's range (red) up to candle 3
            box.new(cBar, cH, bar_index, cL, border_color = cSell, border_width = 1, bgcolor = color.new(cSell, 85))
            label.new(cBar, cL, "2", style = label.style_label_up, color = cSell, textcolor = color.white, size = size.small)
            label.new(bar_index, high, close > cH ? "3 break" : "3 sweep", style = label.style_label_down, color = #089981, textcolor = color.white, size = size.small)
            if showLines
                lnLow  := line.new(cBar, cL, bar_index, cL, color = cSell, style = line.style_dashed, width = 2)
                lnHigh := line.new(bar_index, high, bar_index, high, color = color.gray, style = line.style_dotted)
        cAct := false
    // candle 2 candidate: red, out of the independent candle
    if close < open and not na(refH) and (not needLowBreak or low < refL)
        cAct := true
        cH   := high
        cL   := low
        cBar := bar_index
        mH   := refH
        mL   := refL
        mBar := refBar
    // this candle is now the independent candle
    refH   := high
    refL   := low
    refBar := bar_index

// C. follow open trades until the stop or target is hit (stop first if both in one candle)
if array.size(trades) > 0
    for i = array.size(trades) - 1 to 0
        Trade t = array.get(trades, i)
        if t.bar == bar_index
            continue
        bool hitSl = high >= t.sl
        bool hitTp = low <= t.tp
        if hitSl or hitTp
            bool win = hitTp and not hitSl
            stats.netR := stats.netR + (win ? rr : -1.0)
            if win
                stats.wins := stats.wins + 1
            else
                stats.losses := stats.losses + 1
            line.set_x2(t.le, bar_index)
            line.set_x2(t.ls, bar_index)
            line.set_x2(t.lt, bar_index)
            label.set_text(t.lb, label.get_text(t.lb) + (win ? "\nRESULT: TP hit +" + str.tostring(rr) + "R" : "\nRESULT: SL hit -1R"))
            array.remove(trades, i)
        else
            line.set_x2(t.le, bar_index + 1)
            line.set_x2(t.ls, bar_index + 1)
            line.set_x2(t.lt, bar_index + 1)

var int firstTime = time
var table tb = table.new(position.top_right, 2, 5, bgcolor = color.new(color.black, 25), border_width = 1)
if barstate.islast and showStats
    int closed = stats.wins + stats.losses
    table.cell(tb, 0, 0, "Sells", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 0, str.tostring(stats.trades), text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 1, "Wins / losses", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 1, str.tostring(stats.wins) + " / " + str.tostring(stats.losses), text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 2, "Win rate", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 2, closed > 0 ? str.tostring(100.0 * stats.wins / closed, "#.0") + "%" : "-", text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 3, "Net R (" + str.tostring(rr) + "R target)", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 3, str.tostring(stats.netR, "#.0") + "R", text_color = stats.netR >= 0 ? color.new(#089981, 0) : cSell, text_size = size.small)
    table.cell(tb, 0, 4, "Since", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 4, str.format_time(firstTime, "yyyy-MM-dd HH:mm", syminfo.timezone), text_color = color.white, text_size = size.small)

barcolor(greyInside and inside ? color.new(color.gray, 30) : na)
plotshape(sell, "Sell", shape.triangledown, location.abovebar, cSell, size = size.tiny)
alertcondition(sell, "Sell (candle 4)", "Independent candle pullback SELL on {{ticker}} {{interval}}")
