// Gold TSMOM signal -- part of zohaibkhanniazi/aitrading
// Time-series momentum (Moskowitz, Ooi & Pedersen 2012; Hurst, Ooi & Pedersen 2017):
// blend of 1, 3 and 12-month trend signals, re-checked once a month, sized to a volatility target.
//@version=5
indicator("Gold TSMOM signal (1/3/12 months)", shorttitle = "TSMOM", overlay = false)

volTarget = input.float(15.0, "Volatility target, % a year", minval = 1, step = 1)
equity    = input.float(10000, "Account equity (for the lot suggestion)", minval = 1)
contract  = input.float(100, "Contract size (oz per 1.00 lot)", minval = 0.0001)
longOnly  = input.bool(false, "Long only")

// daily values, whatever the chart timeframe
[r1, r3, r12, vol, px] = request.security(syminfo.tickerid, "D", [close / close[21] - 1, close / close[63] - 1, close / close[252] - 1, ta.stdev(math.log(close / close[1]), 60) * math.sqrt(252), close])

sgn(x) => x > 0 ? 1.0 : x < 0 ? -1.0 : 0.0
score0 = (sgn(r1) + sgn(r3) + sgn(r12)) / 3.0
score  = longOnly and score0 < 0 ? 0.0 : score0
value  = vol > 0 ? equity * (volTarget / 100) / vol * math.abs(score) : 0.0
lots   = px > 0 ? value / (px * contract) : 0.0

plot(score, "Score", style = plot.style_columns, color = score > 0 ? color.new(#089981, 30) : score < 0 ? color.new(#F23645, 30) : color.gray)
hline(0, "Zero", color = color.gray)
hline(1, "Full long", color = color.new(#089981, 60), linestyle = hline.style_dotted)
hline(-1, "Full short", color = color.new(#F23645, 60), linestyle = hline.style_dotted)

// first trading day of each month = rebalance day
newMonth = month(time) != month(time[1]) and timeframe.isdaily
bgcolor(newMonth ? color.new(color.blue, 85) : na, title = "Rebalance day")

fmt(x) => str.tostring(x * 100, "#.0") + "%"
dirTxt(x) => x > 0 ? "UP" : x < 0 ? "DOWN" : "-"
var table t = table.new(position.top_right, 2, 7, bgcolor = color.new(color.black, 20), border_width = 1)
if barstate.islast
    table.cell(t, 0, 0, "1 month", text_color = color.white, text_size = size.small)
    table.cell(t, 1, 0, fmt(r1) + "  " + dirTxt(r1), text_color = r1 > 0 ? #089981 : #F23645, text_size = size.small)
    table.cell(t, 0, 1, "3 months", text_color = color.white, text_size = size.small)
    table.cell(t, 1, 1, fmt(r3) + "  " + dirTxt(r3), text_color = r3 > 0 ? #089981 : #F23645, text_size = size.small)
    table.cell(t, 0, 2, "12 months", text_color = color.white, text_size = size.small)
    table.cell(t, 1, 2, fmt(r12) + "  " + dirTxt(r12), text_color = r12 > 0 ? #089981 : #F23645, text_size = size.small)
    table.cell(t, 0, 3, "Score", text_color = color.white, text_size = size.small)
    table.cell(t, 1, 3, str.tostring(score, "#.##") + (score > 0 ? "  LONG" : score < 0 ? "  SHORT" : "  FLAT"), text_color = color.white, text_size = size.small)
    table.cell(t, 0, 4, "Gold volatility", text_color = color.white, text_size = size.small)
    table.cell(t, 1, 4, fmt(vol) + " a year", text_color = color.white, text_size = size.small)
    table.cell(t, 0, 5, "Position value", text_color = color.white, text_size = size.small)
    table.cell(t, 1, 5, "$" + str.tostring(value, "#,###"), text_color = color.white, text_size = size.small)
    table.cell(t, 0, 6, "Suggested lots", text_color = color.white, text_size = size.small)
    table.cell(t, 1, 6, str.tostring(lots, "#.##"), text_color = color.white, text_size = size.small)
