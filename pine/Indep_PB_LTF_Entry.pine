// Independent Candle Pullback: H1 setup -> 3m entry (SELL) -- part of zohaibkhanniazi/aitrading
// H1 (setup TF): 1 independent candle -> 2 red candle out of it -> 3 takes 2's high (not its low)
//                -> 4 closes below 2's low  = SELL BIAS (no trade yet).
// 3m (chart TF): point 10 = while H1 candle 4 is still open, a green 3m candle closes back ABOVE
//                candle 2's low (the breaker line); the highest high from that green candle until
//                candle 4 closes is point 10 (latest such green candle counts).
//                A green 3m candle sweeps point 10 (latest sweep counts) ->
//                a 3m candle closes below that sweep candle's low = SELL.
//                Stop above the sweep high, target RR x stop.
// Cancel: close above the H1 pullback high, or no entry within N H1 candles.
// Attach to a 3m (or any lower) chart.
//@version=5
indicator("Indep PB: H1 setup -> 3m entry (sell)", shorttitle = "Indep PB LTF", overlay = true, max_lines_count = 500, max_labels_count = 500, max_bars_back = 1000)

G1 = "Setup (higher timeframe)"
htf          = input.timeframe("60", "Setup timeframe", group = G1)
needLowBreak = input.bool(true, "Candle 2 must go below candle 1's low", group = G1)
needGreen    = input.bool(true, "Candle 3 must be green", group = G1)
expiryH      = input.int(30, "Setup pullback expires after (setup candles)", minval = 1, group = G1)

G2 = "Entry (chart timeframe)"
p10Mode   = input.string("Retest high (green close above candle 2 low)", "Point 10", options = ["Retest high (green close above candle 2 low)", "Last swing high inside candle 4", "High of candle 4"], group = G2)
p10Skip   = input.bool(false, "Retest mode: skip the setup if no green candle closed above the line", group = G2, tooltip = "Off = fall back to the last swing high inside candle 4 (marked 10*).")
sweepGrn  = input.bool(true, "Sweep candle must be green", group = G2)
sweepNeed = input.string("Wick above is enough", "Sweep of point 10 needs", options = ["Wick above is enough", "Body close above point 10"], group = G2)
waitH     = input.int(24, "Wait for the entry up to (setup candles after candle 4)", minval = 1, group = G2)
rr        = input.float(3.0, "Target (R multiple)", minval = 0.5, step = 0.5, group = G2)
slBuf     = input.float(0.0, "Stop buffer above the sweep high (price)", minval = 0, step = 0.1, group = G2)
showStats = input.bool(true, "Results table", group = G2)
cSell     = input.color(#F23645, "Sell colour", group = G2)
cInd      = input.color(#2962FF, "Independent candle (1)", group = G2)

// ---------------------------------------------------------------- H1 pattern (runs on the setup timeframe)
htfLogic() =>
    var float refH  = na
    var float refL  = na
    var int   refT  = na
    var bool  cAct  = false
    var float cH    = na
    var float cL    = na
    var int   cT    = na
    var int   mT    = na
    var float mH    = na
    var float mL    = na
    var bool  vAct  = false
    var float vLow  = na
    var float vHigh = na
    var int   vAge  = 0
    // snapshot of candles 1 and 2 for drawing the valid pullback
    var int   dMT = na
    var float dMH = na
    var float dML = na
    var int   dCT = na
    var float dCH = na
    var float dCL = na
    bool  inside = not na(refH) and high <= refH and low >= refL
    bool  sig    = false
    bool  vNew   = false
    float lvl    = na
    float pb     = na
    if vAct
        vAge += 1
        if close < vLow
            sig := true
            lvl := vLow
            pb  := math.max(vHigh, high)
            vAct := false
        else if close > vHigh or vAge > expiryH
            vAct := false
        else
            vHigh := math.max(vHigh, high)
    if not inside
        if cAct
            if high > cH and not (low < cL) and (not needGreen or close > open)
                vAct  := true
                vLow  := cL
                vHigh := high
                vAge  := 0
                vNew  := true
                dMT := mT
                dMH := mH
                dML := mL
                dCT := cT
                dCH := cH
                dCL := cL
            cAct := false
        if close < open and not na(refH) and (not needLowBreak or low < refL)
            cAct := true
            cH   := high
            cL   := low
            cT   := time
            mT   := refT
            mH   := refH
            mL   := refL
        refH := high
        refL := low
        refT := time
    // values of the last CLOSED setup candle (no repainting)
    [sig[1], lvl[1], pb[1], high[1], low[1], time[1], vNew[1], dMT[1], dMH[1], dML[1], dCT[1], dCH[1], dCL[1]]

[hSig, hLvl, hPB, h4High, h4Low, h4Time, hVNew, hMT, hMH, hML, hCT, hCH, hCL] = request.security(syminfo.tickerid, htf, htfLogic(), lookahead = barmerge.lookahead_on)
bool tfOk = timeframe.in_seconds() < timeframe.in_seconds(htf)
bool newSetup = tfOk and hSig and ta.change(h4Time) != 0

// ---------------------------------------------------------------- draw the setup-timeframe pattern (1-2-3, then 4)
bool newHtfBar = ta.change(h4Time) != 0
int  dur = timeframe.in_seconds(htf) * 1000
var line lnH1 = na
if newHtfBar and hVNew
    box.new(hMT, hMH, hCT, hML, xloc = xloc.bar_time, border_color = cInd, border_width = 2, bgcolor = color.new(cInd, 85))
    label.new(hMT, hML, "1", xloc = xloc.bar_time, style = label.style_label_up, color = cInd, textcolor = color.white, size = size.small)
    box.new(hCT, hCH, hCT + dur, hCL, xloc = xloc.bar_time, border_color = cSell, border_width = 2, bgcolor = color.new(cSell, 85))
    label.new(hCT, hCL, "2", xloc = xloc.bar_time, style = label.style_label_up, color = cSell, textcolor = color.white, size = size.small)
    box.new(h4Time, h4High, h4Time + dur, h4Low, xloc = xloc.bar_time, border_color = color.new(#089981, 0), border_width = 2, bgcolor = color.new(#089981, 85))
    label.new(h4Time, h4High, "3  " + htf + " valid pullback", xloc = xloc.bar_time, style = label.style_label_down, color = #089981, textcolor = color.white, size = size.small)
    lnH1 := line.new(hCT, hCL, time, hCL, xloc = xloc.bar_time, color = cSell, style = line.style_dashed, width = 2)
if not na(lnH1)
    line.set_x2(lnH1, time)
if newHtfBar and hSig
    box.new(h4Time, h4High, h4Time + dur, h4Low, xloc = xloc.bar_time, border_color = cSell, border_width = 3, bgcolor = color.new(cSell, 75))
    label.new(h4Time + math.round(dur / 2), h4High, "4  " + htf + " close below 2 = SELL bias", xloc = xloc.bar_time, style = label.style_label_down, color = cSell, textcolor = color.white, size = size.small)
    lnH1 := na

// ---------------------------------------------------------------- trades + stats
type Trade
    float entry
    float sl
    float tp
    int   bar
    line  le
    line  ls
    line  lt
    label lb

type Stats
    int   trades = 0
    int   wins = 0
    int   losses = 0
    float netR = 0.0

var array<Trade> trades = array.new<Trade>()
var Stats stats = Stats.new()

// ---------------------------------------------------------------- 3m entry state
var bool  lAct   = false
var float p10    = na
var float lvl2   = na
var float pbHigh = na
var int   lStart = na
var bool  sAct   = false
var float sL     = na
var float sExt   = na
var int   sBar   = na
var line  lnP10  = na
var line  lnLvl  = na

int ratio = math.max(1, math.round(timeframe.in_seconds(htf) / timeframe.in_seconds()))

if newSetup
    // point 10 (see header); fallback = last swing high inside candle 4
    float found = na
    int   fOff  = na
    string tag  = "10"
    bool  skip  = false
    if p10Mode == "Retest high (green close above candle 2 low)"
        // latest green 3m candle inside candle 4 that closed above candle 2's low
        int gOff = na
        for i = 1 to math.min(ratio + 1, 900)
            if time[i] < h4Time
                break
            if close[i] > open[i] and close[i] > hLvl
                gOff := i
                break
        if not na(gOff)
            found := high[gOff]
            fOff  := gOff
            for j = 1 to gOff
                if high[j] > found
                    found := high[j]
                    fOff  := j
        else if p10Skip
            skip := true
        else
            tag := "10*"
    if na(found) and not skip and p10Mode != "High of candle 4"
        for i = 2 to math.min(ratio + 2, 900)
            if time[i] < h4Time
                break
            if high[i] > high[i + 1] and high[i] >= high[i - 1]
                found := high[i]
                fOff  := i
                break
    if na(found)
        found := h4High
        fOff  := na
    lAct   := not skip
    p10    := found
    lvl2   := hLvl
    pbHigh := hPB
    lStart := bar_index
    sAct   := false
    label.new(bar_index, high, skip ? "skipped: no retest above 2" : "now wait for 3m entry", style = label.style_label_down, color = color.new(skip ? color.gray : cSell, 20), textcolor = color.white, size = size.tiny)
    if not skip
        if not na(fOff)
            label.new(bar_index - fOff, p10, tag, style = label.style_label_down, color = color.new(#FF9800, 0), textcolor = color.white, size = size.tiny)
        lnP10 := line.new(na(fOff) ? bar_index : bar_index - fOff, p10, bar_index, p10, color = #FF9800, style = line.style_dashed, width = 2)
        lnLvl := line.new(bar_index, lvl2, bar_index, lvl2, color = color.new(cSell, 40), style = line.style_dotted)

bool sell = false
if lAct
    line.set_x2(lnP10, bar_index)
    line.set_x2(lnLvl, bar_index)
    if close > pbHigh or bar_index - lStart > waitH * ratio
        lAct := false
        line.set_color(lnP10, color.new(color.gray, 50))
    else
        // entry: close below the sweep candle's low
        if sAct and bar_index > sBar and close < sL
            sell := true
        else
            if sAct
                sExt := math.max(sExt, high)
            // (latest) sweep of point 10
            if high > p10 and (not sweepGrn or close > open) and (sweepNeed == "Wick above is enough" or close > p10)
                sAct := true
                sL   := low
                sExt := high
                sBar := bar_index
                label.new(bar_index, high, "sweep 10", style = label.style_label_down, color = color(na), textcolor = #FF9800, size = size.tiny)

if sell
    float e  = close
    float sl = math.max(sExt, high) + slBuf
    float tp = e - rr * (sl - e)
    lAct := false
    string txt = "SELL\nEntry " + str.tostring(e, format.mintick) + "\nSL " + str.tostring(sl, format.mintick) + "  (sweep high)\nTP " + str.tostring(tp, format.mintick) + "  (" + str.tostring(rr) + "R)"
    label lb = label.new(bar_index, sl, txt, style = label.style_label_down, color = cSell, textcolor = color.white, size = size.small)
    line le = line.new(bar_index, e, bar_index + 1, e, color = color.new(#2962FF, 0), width = 2)
    line ls = line.new(bar_index, sl, bar_index + 1, sl, color = cSell, width = 2)
    line lt = line.new(bar_index, tp, bar_index + 1, tp, color = color.new(#089981, 0), width = 2)
    array.push(trades, Trade.new(e, sl, tp, bar_index, le, ls, lt, lb))
    stats.trades := stats.trades + 1
    alert("SELL " + syminfo.ticker + " " + timeframe.period + "  entry " + str.tostring(e, format.mintick) + "  SL " + str.tostring(sl, format.mintick) + "  TP " + str.tostring(tp, format.mintick), alert.freq_once_per_bar_close)

// follow open trades (stop first if both are hit in one candle)
if array.size(trades) > 0
    for i = array.size(trades) - 1 to 0
        Trade t = array.get(trades, i)
        if t.bar == bar_index
            continue
        bool hitSl = high >= t.sl
        bool hitTp = low <= t.tp
        if hitSl or hitTp
            bool win = hitTp and not hitSl
            stats.netR := stats.netR + (win ? rr : -1.0)
            if win
                stats.wins := stats.wins + 1
            else
                stats.losses := stats.losses + 1
            line.set_x2(t.le, bar_index)
            line.set_x2(t.ls, bar_index)
            line.set_x2(t.lt, bar_index)
            label.set_text(t.lb, label.get_text(t.lb) + (win ? "\nRESULT: TP hit +" + str.tostring(rr) + "R" : "\nRESULT: SL hit -1R"))
            array.remove(trades, i)
        else
            line.set_x2(t.le, bar_index + 1)
            line.set_x2(t.ls, bar_index + 1)
            line.set_x2(t.lt, bar_index + 1)

var int firstTime = time
var table tb = table.new(position.top_right, 2, 5, bgcolor = color.new(color.black, 25), border_width = 1)
if barstate.islast and not tfOk
    table.cell(tb, 0, 0, "Showing the " + htf + " pattern (1-2-3-4) only. Open a 3m chart for the entries.", text_color = color.orange, text_size = size.normal)
if barstate.islast and showStats and tfOk
    int closed = stats.wins + stats.losses
    table.cell(tb, 0, 0, "Sells (" + htf + " setup / " + timeframe.period + " entry)", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 0, str.tostring(stats.trades), text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 1, "Wins / losses", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 1, str.tostring(stats.wins) + " / " + str.tostring(stats.losses), text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 2, "Win rate", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 2, closed > 0 ? str.tostring(100.0 * stats.wins / closed, "#.0") + "%" : "-", text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 3, "Net R (" + str.tostring(rr) + "R target)", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 3, str.tostring(stats.netR, "#.0") + "R", text_color = stats.netR >= 0 ? color.new(#089981, 0) : cSell, text_size = size.small)
    table.cell(tb, 0, 4, "Since", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 4, str.format_time(firstTime, "yyyy-MM-dd HH:mm", syminfo.timezone), text_color = color.white, text_size = size.small)

plotshape(sell, "Sell", shape.triangledown, location.abovebar, cSell, size = size.tiny)
alertcondition(sell, "Sell (3m entry)", "Indep PB 3m SELL on {{ticker}} {{interval}}")
alertcondition(newSetup, "H1 sell setup", "Indep PB H1 sell setup on {{ticker}}")
