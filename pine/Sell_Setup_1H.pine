// Sell Setup 1H (owner's confirmed rules) -- part of zohaibkhanniazi/aitrading
// Logic always runs on the SETUP timeframe (default 1H):
// 1. Independent candle = not inside the last independent candle (own high or low). Inside candles are ignored.
// 2. R = newest independent RED candle.
// 3. Valid pullback = a later GREEN candle takes R's high (wick or close above) WITHOUT going below R's low.
//    If price takes R's low first, or both sides at once, R is finished (no pullback).
// 4. BC (break candle) = a candle closes below R's low.
// 5. No cancel: a close above the sweep high does not cancel; keep waiting for the close below.
// 6. Several valid pullbacks can wait at once (newest = main). A close below several lows counts for all of them.
// On the 1H chart: full marking. On a lower chart (3m / 5m): the range of each BC candle is highlighted, and the
// valid pullbacks of the lower chart (same rules) that happen inside that BC candle are numbered h1, h2, h3...
//@version=5
indicator("Sell Setup 1H (pullback sweep + BC)", shorttitle = "Sell Setup", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

setupTf    = input.timeframe("60", "Setup timeframe")
greyInside = input.bool(true, "Grey out inside candles (setup chart only)")
maxActive  = input.int(20, "Max setups waiting at once (oldest dropped)", minval = 1, maxval = 100)
cSell      = input.color(#F23645, "BC / pullback colour")
cGreen     = input.color(#089981, "Sweep colour")
showH      = input.bool(true, "Lower chart: number the valid pullbacks inside each BC candle (h1, h2, ...)")
earlyR     = input.bool(false, "Lower chart: the red candle may start before the BC candle (only the sweep must be inside)")
cH_        = input.color(#FF9800, "h1 / h2 / h3 colour")

int  setupSec = timeframe.in_seconds(setupTf)
bool onSetup  = timeframe.in_seconds() == setupSec
bool lowerTf  = timeframe.in_seconds() < setupSec

// =====================================================================
// A. Lower timeframe: same rules computed on the setup timeframe, only BC ranges drawn
// =====================================================================
bcLogic() =>
    var float refH = na
    var float refL = na
    var bool  cAct = false
    var float cH   = na
    var float cL   = na
    var array<float> lv = array.new<float>()
    bool ins = not na(refH) and high <= refH and low >= refL
    int  n   = 0
    if array.size(lv) > 0
        for i = array.size(lv) - 1 to 0
            if close < array.get(lv, i)
                n += 1
                array.remove(lv, i)
    if not ins
        if cAct
            bool tH = high > cH
            bool tL = low < cL
            if tH and not tL and close > open
                array.push(lv, cL)
                if array.size(lv) > maxActive
                    array.shift(lv)
                cAct := false
            else if tL
                cAct := false
        if close < open
            cAct := true
            cH   := high
            cL   := low
        refH := high
        refL := low
    // last CLOSED setup candle (no repainting)
    [n[1], high[1], low[1], time[1]]

[bcN, bcH, bcL, bcT] = request.security(syminfo.tickerid, setupTf, bcLogic(), lookahead = barmerge.lookahead_on)
bool newSetupBar = ta.change(bcT) != 0

// valid pullbacks on the lower chart itself (same rules), remembered so they can be numbered inside a BC candle
type PB
    int   sweepBar
    int   sweepTime
    float sweepHigh
    int   rBar
    int   rTime

var array<PB> pbs = array.new<PB>()
var float l3RefH = na
var float l3RefL = na
var bool  l3Act  = false
var float l3H    = na
var float l3L    = na
var int   l3Bar  = na
var int   l3Time = na
bool l3Inside = not na(l3RefH) and high <= l3RefH and low >= l3RefL
if lowerTf and not l3Inside
    if l3Act
        bool tH3 = high > l3H
        bool tL3 = low < l3L
        if tH3 and not tL3 and close > open
            array.push(pbs, PB.new(bar_index, time, high, l3Bar, l3Time))
            if array.size(pbs) > 400
                array.shift(pbs)
            l3Act := false
        else if tL3
            l3Act := false
    if close < open
        l3Act  := true
        l3H    := high
        l3L    := low
        l3Bar  := bar_index
        l3Time := time
    l3RefH := high
    l3RefL := low

if lowerTf and newSetupBar and bcN > 0
    int bcEnd = bcT + setupSec * 1000
    box.new(bcT, bcH, bcEnd, bcL, xloc = xloc.bar_time, border_color = cSell, border_width = 2, bgcolor = color.new(cSell, 85), text = bcN > 1 ? "BC x" + str.tostring(bcN) : "BC", text_color = cSell, text_size = size.small, text_valign = text.align_top, text_halign = text.align_left)
    if showH and array.size(pbs) > 0
        int k = 0
        for i = 0 to array.size(pbs) - 1
            PB e = array.get(pbs, i)
            if e.sweepTime >= bcT and e.sweepTime < bcEnd and (earlyR or e.rTime >= bcT)
                k += 1
                label.new(e.sweepBar, e.sweepHigh, "h" + str.tostring(k), style = label.style_label_down, color = cH_, textcolor = color.white, size = size.tiny)
                line.new(e.rBar, e.sweepHigh, e.sweepBar, e.sweepHigh, color = cH_, style = line.style_dotted)

// =====================================================================
// B. Setup timeframe chart (1H): full marking
// =====================================================================
type Setup
    float lvl
    int   rBar
    line  ln

var array<Setup> setups = array.new<Setup>()
var float refH = na
var float refL = na
var bool  cAct = false
var float cH   = na
var float cL   = na
var int   cBar = na
bool inside = not na(refH) and high <= refH and low >= refL
bool bcNow  = false

if onSetup
    // 1. waiting setups: a close below R's low -> BC (every setup it closes below)
    int nTrig = 0
    if array.size(setups) > 0
        for i = array.size(setups) - 1 to 0
            Setup st = array.get(setups, i)
            line.set_x2(st.ln, bar_index)
            if close < st.lvl
                line.set_color(st.ln, cSell)
                line.set_style(st.ln, line.style_solid)
                nTrig += 1
                array.remove(setups, i)
    if nTrig > 0
        bcNow := true
        label.new(bar_index, high, nTrig > 1 ? "BC (" + str.tostring(nTrig) + " setups)" : "BC", style = label.style_label_down, color = cSell, textcolor = color.white, size = size.small)
    // 2. the pattern is built only from independent candles
    if not inside
        if cAct
            bool tH = high > cH
            bool tL = low < cL
            if tH and not tL and close > open
                box.new(cBar, cH, bar_index, cL, border_color = cSell, border_width = 2, bgcolor = color.new(cSell, 85))
                label.new(cBar, cL, "R", style = label.style_label_up, color = cSell, textcolor = color.white, size = size.small)
                label.new(bar_index, high, close > cH ? "close above" : "sweep", style = label.style_label_down, color = cGreen, textcolor = color.white, size = size.tiny)
                line ln = line.new(cBar, cL, bar_index, cL, color = color.new(cSell, 20), style = line.style_dashed, width = 2)
                array.push(setups, Setup.new(cL, cBar, ln))
                if array.size(setups) > maxActive
                    Setup old = array.shift(setups)
                    line.set_color(old.ln, color.new(color.gray, 50))
                cAct := false
            else if tL
                cAct := false
        if close < open
            cAct := true
            cH   := high
            cL   := low
            cBar := bar_index
        refH := high
        refL := low

barcolor(onSetup and greyInside and inside ? color.new(color.gray, 30) : na)
plotshape(bcNow, "BC", shape.triangledown, location.abovebar, cSell, size = size.tiny)

var table note = table.new(position.bottom_right, 1, 1)
if barstate.islast and not onSetup and not lowerTf
    table.cell(note, 0, 0, "Sell Setup: open the " + setupTf + " chart or a lower one", text_color = color.orange)

alertcondition(onSetup ? bcNow : (lowerTf and newSetupBar and bcN > 0), "BC (close below R)", "BC on {{ticker}}: setup-timeframe close below the pullback candle's low")
