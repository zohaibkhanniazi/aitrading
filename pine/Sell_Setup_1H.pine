// Sell Setup 1H (owner's confirmed rules) -- part of zohaibkhanniazi/aitrading
// Logic always runs on the SETUP timeframe (default 1H):
// 1. Independent candle = not inside the last independent candle (own high or low). Inside candles are ignored.
// 2. R = newest independent RED candle.
// 3. Valid pullback = a later GREEN candle takes R's high (wick or close above) WITHOUT going below R's low.
//    If price takes R's low first, or both sides at once, R is finished (no pullback).
// 4. BC (break candle) = a candle closes below R's low.
// 5. No cancel: a close above the sweep high does not cancel; keep waiting for the close below.
// 6. Several valid pullbacks can wait at once (newest = main). A close below several lows counts for all of them.
// On the 1H chart: full marking. On a lower chart (3m / 5m), only:
//   - the range of each BC candle,
//   - CC  = the lower-chart candle inside BC that closes below R's low (the exact break),
//   - NCC = the first candle after CC that comes back up and tests CC's breaker point (R's low).
//           If the next candle does not test it, the following one is checked, and so on.
//           Horizontal lines at the NCC high and low, from NCC until NCCLT.
//   - NCCLT = the first candle (any colour) after NCC whose high goes above the NCC high (takes that liquidity).
//   - SELL  = the first candle after NCCLT that closes (body) below the NCCLT low. Entry = its close,
//             SL = NCCLT high, TP = RR x risk. Results are tracked in a table.
//   (optional: numbered lower-chart pullbacks h1, h2, ... inside BC)
//@version=5
indicator("Sell Setup 1H (pullback sweep + BC)", shorttitle = "Sell Setup", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

setupTf    = input.timeframe("60", "Setup timeframe")
greyInside = input.bool(true, "Grey out inside candles (setup chart only)")
maxActive  = input.int(20, "Max setups waiting at once (oldest dropped)", minval = 1, maxval = 100)
cSell      = input.color(#F23645, "BC / pullback colour")
cGreen     = input.color(#089981, "Sweep colour")
showCC     = input.bool(true, "Lower chart: mark CC (exact break candle) and NCC (next candle) with lines")
ccMode     = input.string("Close below", "CC = first candle that", options = ["Close below", "Trades below (wick)"], tooltip = "...the level of R's low (the 1H level BC closed below)")
nccTol     = input.float(0.0, "NCC test tolerance (price below the breaker point that still counts)", minval = 0, step = 0.1)
nccMax     = input.int(200, "Stop looking for NCC after (candles after CC)", minval = 1, maxval = 2000)
cCC        = input.color(#2962FF, "CC / NCC colour")
cLT        = input.color(#9C27B0, "NCCLT colour")
rrE        = input.float(3.0, "Target (R multiple)", minval = 0.5, step = 0.5, group = "Trade")
showStats  = input.bool(true, "Results table", group = "Trade")
ccFor      = input.string("Latest BC", "Draw CC / NCC / NCCLT for", options = ["Latest BC", "Selected BC", "All BCs"], tooltip = "Latest BC = only the most recent BC block (older drawings are removed). Selected BC = the block you click (see below). All BCs = every block.")
selT       = input.time(timestamp("2026-01-01 00:00 +0000"), "Selected BC: click inside the BC block (used when 'Selected BC' is chosen)", confirm = true, tooltip = "When you add the indicator, click on the chart inside the BC block you want. To pick another block later, select the indicator and drag its point, or change this time in Settings.")
showH      = input.bool(false, "Lower chart: number the valid pullbacks inside each BC candle (h1, h2, ...)")
earlyR     = input.bool(false, "Lower chart: the red candle may start before the BC candle (only the sweep must be inside)")
cH_        = input.color(#FF9800, "h1 / h2 / h3 colour")

int  setupSec = timeframe.in_seconds(setupTf)
bool onSetup  = timeframe.in_seconds() == setupSec
bool lowerTf  = timeframe.in_seconds() < setupSec

// =====================================================================
// A. Lower timeframe: same rules computed on the setup timeframe, only BC ranges drawn
// =====================================================================
bcLogic() =>
    var float refH = na
    var float refL = na
    var bool  cAct = false
    var float cH   = na
    var float cL   = na
    var array<float> lv = array.new<float>()
    bool  ins = not na(refH) and high <= refH and low >= refL
    int   n   = 0
    float hit = na
    if array.size(lv) > 0
        for i = array.size(lv) - 1 to 0
            float v = array.get(lv, i)
            if close < v
                n += 1
                hit := na(hit) ? v : math.max(hit, v)
                array.remove(lv, i)
    if not ins
        if cAct
            bool tH = high > cH
            bool tL = low < cL
            if tH and not tL and close > open
                array.push(lv, cL)
                if array.size(lv) > maxActive
                    array.shift(lv)
                cAct := false
            else if tL
                cAct := false
        if close < open
            cAct := true
            cH   := high
            cL   := low
        refH := high
        refL := low
    // last CLOSED setup candle (no repainting)
    [n[1], high[1], low[1], time[1], hit[1]]

[bcN, bcH, bcL, bcT, bcLvl] = request.security(syminfo.tickerid, setupTf, bcLogic(), lookahead = barmerge.lookahead_on)
bool newSetupBar = ta.change(bcT) != 0

// valid pullbacks on the lower chart itself (same rules), remembered so they can be numbered inside a BC candle
type PB
    int   sweepBar
    int   sweepTime
    float sweepHigh
    int   rBar
    int   rTime

var array<PB> pbs = array.new<PB>()
var float l3RefH = na
var float l3RefL = na
var bool  l3Act  = false
var float l3H    = na
var float l3L    = na
var int   l3Bar  = na
var int   l3Time = na
bool l3Inside = not na(l3RefH) and high <= l3RefH and low >= l3RefL
if lowerTf and not l3Inside
    if l3Act
        bool tH3 = high > l3H
        bool tL3 = low < l3L
        if tH3 and not tL3 and close > open
            array.push(pbs, PB.new(bar_index, time, high, l3Bar, l3Time))
            if array.size(pbs) > 400
                array.shift(pbs)
            l3Act := false
        else if tL3
            l3Act := false
    if close < open
        l3Act  := true
        l3H    := high
        l3L    := low
        l3Bar  := bar_index
        l3Time := time
    l3RefH := high
    l3RefL := low

// ---------------------------------------------------------------- trades (lower chart)
type Trade
    float entry
    float sl
    float tp
    int   bar
    int   chk
    line  le
    line  ls
    line  lt
    label lb

type Stats
    int   trades = 0
    int   wins = 0
    int   losses = 0
    float netR = 0.0

var array<Trade> trades = array.new<Trade>()
var Stats stats = Stats.new()

// SELL at the close of the candle `off` candles ago, stop at `sl`
openTradeAt(array<Trade> ts, Stats st, int off, float sl) =>
    float e  = close[off]
    float tp = e - rrE * (sl - e)
    int   x  = bar_index - off
    string txt = "SELL\nEntry " + str.tostring(e, format.mintick) + "\nSL " + str.tostring(sl, format.mintick) + "  (NCCLT high)\nTP " + str.tostring(tp, format.mintick) + "  (" + str.tostring(rrE) + "R)"
    label lb = label.new(x, sl, txt, style = label.style_label_down, color = cSell, textcolor = color.white, size = size.small)
    line le = line.new(x, e, x + 1, e, color = color.new(#2962FF, 0), width = 2)
    line ls = line.new(x, sl, x + 1, sl, color = cSell, width = 2)
    line lt = line.new(x, tp, x + 1, tp, color = color.new(#089981, 0), width = 2)
    array.push(ts, Trade.new(e, sl, tp, x, x, le, ls, lt, lb))
    st.trades := st.trades + 1
    alert("SELL " + syminfo.ticker + "  entry " + str.tostring(e, format.mintick) + "  SL " + str.tostring(sl, format.mintick) + "  TP " + str.tostring(tp, format.mintick), alert.freq_once_per_bar_close)
    true

// check every closed candle after the entry for the stop or the target (stop first if both in one candle)
updateTrades(array<Trade> ts, Stats st) =>
    int n = array.size(ts)
    if n > 0
        for i = n - 1 to 0
            Trade t = array.get(ts, i)
            int first = bar_index - 1 - t.chk
            bool done = false
            if first >= 1
                for o = math.min(first, 400) to 1
                    bool hitSl = high[o] >= t.sl
                    bool hitTp = low[o] <= t.tp
                    if hitSl or hitTp
                        bool win = hitTp and not hitSl
                        st.netR := st.netR + (win ? rrE : -1.0)
                        if win
                            st.wins := st.wins + 1
                        else
                            st.losses := st.losses + 1
                        int xe = bar_index - o
                        line.set_x2(t.le, xe)
                        line.set_x2(t.ls, xe)
                        line.set_x2(t.lt, xe)
                        label.set_text(t.lb, label.get_text(t.lb) + (win ? "\nRESULT: TP hit +" + str.tostring(rrE) + "R" : "\nRESULT: SL hit -1R"))
                        done := true
                        break
            if done
                array.remove(ts, i)
            else
                t.chk := bar_index - 1
                line.set_x2(t.le, bar_index)
                line.set_x2(t.ls, bar_index)
                line.set_x2(t.lt, bar_index)
    true

// entry search after NCCLT
var bool  eSearch = false
var float eLow    = na
var float eHigh   = na
var int   eStart  = na

// first already-closed candle after NCCLT (offset ltOff) that closes below the NCCLT low
eFind(int ltOff, float lvl) =>
    int f = na
    if ltOff >= 2
        for j = ltOff - 1 to 1
            if close[j] < lvl
                f := j
                break
    f

// ---------------------------------------------------------------- CC / NCC / NCCLT (lower chart)
// drawings of the current block (deleted when the next BC replaces it in "Latest BC" mode)
var array<label> blkLabels = array.new<label>()
var array<line>  blkLines  = array.new<line>()
var bool  nSearch  = false   // waiting for NCC: a candle that tests the breaker point
var float nLvl     = na
var int   nCCBar   = na
var bool  ltSearch = false   // waiting for NCCLT: a candle above the NCC high
var float ltLvl    = na
var int   ltStart  = na
var line  ncHi     = na
var line  ncLo     = na

clearBlock() =>
    for lb in blkLabels
        label.delete(lb)
    for ln in blkLines
        line.delete(ln)
    array.clear(blkLabels)
    array.clear(blkLines)
    true

// NCC lines start at the NCC candle; they are stretched until NCCLT happens
drawNcc(int off) =>
    line a = line.new(bar_index - off, high[off], bar_index - off, high[off], color = cCC, width = 2)
    line b = line.new(bar_index - off, low[off], bar_index - off, low[off], color = cCC, width = 2)
    label c = label.new(bar_index - off, low[off], "NCC", style = label.style_label_up, color = cCC, textcolor = color.white, size = size.tiny)
    array.push(blkLines, a)
    array.push(blkLines, b)
    array.push(blkLabels, c)
    [a, b]

drawLt(int off) =>
    label c = label.new(bar_index - off, high[off], "NCCLT", style = label.style_label_down, color = cLT, textcolor = color.white, size = size.tiny)
    array.push(blkLabels, c)
    true

// first already-closed candle after the NCC candle whose high goes above the NCC high
ltFind(int ncOff, float lvl) =>
    int f = na
    if ncOff >= 2
        for j = ncOff - 1 to 1
            if high[j] > lvl
                f := j
                break
    f

bool otherBc = newSetupBar and bcN > 0

// waiting for the entry (close below the NCCLT low)
if lowerTf and eSearch and not otherBc
    if close[1] < eLow
        openTradeAt(trades, stats, 1, eHigh)
        eSearch := false
    else if bar_index - 1 - eStart > nccMax
        eSearch := false

// waiting for NCCLT
if lowerTf and ltSearch and not otherBc
    if high[1] > ltLvl
        drawLt(1)
        line.set_x2(ncHi, bar_index - 1)
        line.set_x2(ncLo, bar_index - 1)
        ltSearch := false
        eSearch  := true
        eLow     := low[1]
        eHigh    := high[1]
        eStart   := bar_index - 1
    else if bar_index - 1 - ltStart > nccMax
        ltSearch := false
    else
        line.set_x2(ncHi, bar_index)
        line.set_x2(ncLo, bar_index)

// waiting for NCC
if lowerTf and nSearch and not otherBc
    if high[1] >= nLvl - nccTol
        [a1, b1] = drawNcc(1)
        ncHi     := a1
        ncLo     := b1
        nSearch  := false
        ltSearch := true
        ltLvl    := high[1]
        ltStart  := bar_index - 1
    else if bar_index - 1 - nCCBar > nccMax
        nSearch := false

if lowerTf and otherBc
    int bcEnd = bcT + setupSec * 1000
    box.new(bcT, bcH, bcEnd, bcL, xloc = xloc.bar_time, border_color = cSell, border_width = 2, bgcolor = color.new(cSell, 85), text = bcN > 1 ? "BC x" + str.tostring(bcN) : "BC", text_color = cSell, text_size = size.small, text_valign = text.align_top, text_halign = text.align_left)
    bool sel = ccFor != "Selected BC" or (selT >= bcT and selT < bcEnd)
    if showCC and sel and not na(bcLvl)
        if ccFor == "Latest BC"
            clearBlock()
        else
            array.clear(blkLabels)
            array.clear(blkLines)
        nSearch  := false
        ltSearch := false
        eSearch  := false
        array.push(blkLines, line.new(bcT, bcLvl, bcEnd, bcLvl, xloc = xloc.bar_time, color = color.new(cSell, 30), style = line.style_dotted))
        // CC = oldest candle inside BC that closes (or trades) below R's low
        int ratio = math.max(1, math.round(setupSec / timeframe.in_seconds()))
        int cc = na
        for i = math.min(ratio, 400) to 1
            if time[i] >= bcT and time[i] < bcEnd
                bool brk = ccMode == "Close below" ? close[i] < bcLvl : low[i] < bcLvl
                if brk
                    cc := i
                    break
        if not na(cc)
            array.push(blkLabels, label.new(bar_index - cc, high[cc], "CC", style = label.style_label_down, color = cCC, textcolor = color.white, size = size.tiny))
            // NCC among the candles already closed after CC
            int nc = na
            if cc >= 2
                for j = cc - 1 to 1
                    if high[j] >= bcLvl - nccTol
                        nc := j
                        break
            if not na(nc)
                [a2, b2] = drawNcc(nc)
                ncHi := a2
                ncLo := b2
                int lt = ltFind(nc, high[nc])
                if not na(lt)
                    drawLt(lt)
                    line.set_x2(ncHi, bar_index - lt)
                    line.set_x2(ncLo, bar_index - lt)
                    int en = eFind(lt, low[lt])
                    if not na(en)
                        openTradeAt(trades, stats, en, high[lt])
                    else
                        eSearch := true
                        eLow    := low[lt]
                        eHigh   := high[lt]
                        eStart  := bar_index - lt
                else
                    ltSearch := true
                    ltLvl    := high[nc]
                    ltStart  := bar_index - nc
                    line.set_x2(ncHi, bar_index)
                    line.set_x2(ncLo, bar_index)
            else
                nSearch := true
                nLvl    := bcLvl
                nCCBar  := bar_index - cc
    if showH and array.size(pbs) > 0
        int k = 0
        for i = 0 to array.size(pbs) - 1
            PB e = array.get(pbs, i)
            if e.sweepTime >= bcT and e.sweepTime < bcEnd and (earlyR or e.rTime >= bcT)
                k += 1
                label.new(e.sweepBar, e.sweepHigh, "h" + str.tostring(k), style = label.style_label_down, color = cH_, textcolor = color.white, size = size.tiny)
                line.new(e.rBar, e.sweepHigh, e.sweepBar, e.sweepHigh, color = cH_, style = line.style_dotted)

if lowerTf
    updateTrades(trades, stats)

var int firstTime = time
var table tb = table.new(position.top_right, 2, 5, bgcolor = color.new(color.black, 25), border_width = 1)
if barstate.islast and lowerTf and showStats
    int closed = stats.wins + stats.losses
    table.cell(tb, 0, 0, "Sells (" + setupTf + " BC / " + timeframe.period + " entry)", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 0, str.tostring(stats.trades), text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 1, "Wins / losses", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 1, str.tostring(stats.wins) + " / " + str.tostring(stats.losses), text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 2, "Win rate", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 2, closed > 0 ? str.tostring(100.0 * stats.wins / closed, "#.0") + "%" : "-", text_color = color.white, text_size = size.small)
    table.cell(tb, 0, 3, "Net R (" + str.tostring(rrE) + "R target)", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 3, str.tostring(stats.netR, "#.0") + "R", text_color = stats.netR >= 0 ? color.new(#089981, 0) : cSell, text_size = size.small)
    table.cell(tb, 0, 4, "Since", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 4, str.format_time(firstTime, "yyyy-MM-dd HH:mm", syminfo.timezone), text_color = color.white, text_size = size.small)

// =====================================================================
// B. Setup timeframe chart (1H): full marking
// =====================================================================
type Setup
    float lvl
    int   rBar
    line  ln

var array<Setup> setups = array.new<Setup>()
var float refH = na
var float refL = na
var bool  cAct = false
var float cH   = na
var float cL   = na
var int   cBar = na
bool inside = not na(refH) and high <= refH and low >= refL
bool bcNow  = false

if onSetup
    // 1. waiting setups: a close below R's low -> BC (every setup it closes below)
    int nTrig = 0
    if array.size(setups) > 0
        for i = array.size(setups) - 1 to 0
            Setup st = array.get(setups, i)
            line.set_x2(st.ln, bar_index)
            if close < st.lvl
                line.set_color(st.ln, cSell)
                line.set_style(st.ln, line.style_solid)
                nTrig += 1
                array.remove(setups, i)
    if nTrig > 0
        bcNow := true
        label.new(bar_index, high, nTrig > 1 ? "BC (" + str.tostring(nTrig) + " setups)" : "BC", style = label.style_label_down, color = cSell, textcolor = color.white, size = size.small)
    // 2. the pattern is built only from independent candles
    if not inside
        if cAct
            bool tH = high > cH
            bool tL = low < cL
            if tH and not tL and close > open
                box.new(cBar, cH, bar_index, cL, border_color = cSell, border_width = 2, bgcolor = color.new(cSell, 85))
                label.new(cBar, cL, "R", style = label.style_label_up, color = cSell, textcolor = color.white, size = size.small)
                label.new(bar_index, high, close > cH ? "close above" : "sweep", style = label.style_label_down, color = cGreen, textcolor = color.white, size = size.tiny)
                line ln = line.new(cBar, cL, bar_index, cL, color = color.new(cSell, 20), style = line.style_dashed, width = 2)
                array.push(setups, Setup.new(cL, cBar, ln))
                if array.size(setups) > maxActive
                    Setup old = array.shift(setups)
                    line.set_color(old.ln, color.new(color.gray, 50))
                cAct := false
            else if tL
                cAct := false
        if close < open
            cAct := true
            cH   := high
            cL   := low
            cBar := bar_index
        refH := high
        refL := low

barcolor(onSetup and greyInside and inside ? color.new(color.gray, 30) : na)
plotshape(bcNow, "BC", shape.triangledown, location.abovebar, cSell, size = size.tiny)

var table note = table.new(position.bottom_right, 1, 1)
if barstate.islast and not onSetup and not lowerTf
    table.cell(note, 0, 0, "Sell Setup: open the " + setupTf + " chart or a lower one", text_color = color.orange)

alertcondition(onSetup ? bcNow : (lowerTf and newSetupBar and bcN > 0), "BC (close below R)", "BC on {{ticker}}: setup-timeframe close below the pullback candle's low")
