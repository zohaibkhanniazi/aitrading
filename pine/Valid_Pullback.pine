// Valid Pullback marker -- part of zohaibkhanniazi/aitrading
// BULLISH valid pullback: a red candle, then the next candle takes its HIGH
//   (sweep = wick above, close back below; break = body closes above)
//   WITHOUT taking the red candle's LOW. If it also takes the low -> not valid.
// BEARISH valid pullback: mirror image (a green candle, then the next candle takes its LOW
//   without taking its HIGH).
//@version=5
indicator("Valid Pullback (sweep / break of the pullback candle)", shorttitle = "Valid PB", overlay = true, max_boxes_count = 500, max_labels_count = 500, max_bars_back = 500)

needColor   = input.bool(true, "Sweeping candle must be the opposite colour (green after red, red after green)")
showBull    = input.bool(true, "Bullish pullbacks (red candle, high taken)")
showBear    = input.bool(true, "Bearish pullbacks (green candle, low taken)")
showInvalid = input.bool(true, "Mark invalid ones (both high and low taken) with a grey x")
showBox     = input.bool(true, "Box around the pullback candle")
cBull       = input.color(#089981, "Bullish colour")
cBear       = input.color(#F23645, "Bearish colour")

isRed1   = close[1] < open[1]
isGreen1 = close[1] > open[1]
isGreen0 = close > open
isRed0   = close < open

// ---- bullish: previous candle red, this candle takes its high
takesHigh  = high > high[1]
takesLow   = low < low[1]
bullCand   = showBull and isRed1 and takesHigh and (not needColor or isGreen0)
bullValid  = bullCand and not takesLow
bullBreak  = bullValid and close > high[1]
bullSweep  = bullValid and close <= high[1]
bullBad    = bullCand and takesLow

// ---- bearish: previous candle green, this candle takes its low
bearCand   = showBear and isGreen1 and takesLow and (not needColor or isRed0)
bearValid  = bearCand and not takesHigh
bearBreak  = bearValid and close < low[1]
bearSweep  = bearValid and close >= low[1]
bearBad    = bearCand and takesHigh

// marks on the candle that took the level
plotshape(bullBreak, "Bullish PB (break)", shape.triangleup, location.belowbar, cBull, text = "PB break", textcolor = cBull, size = size.tiny)
plotshape(bullSweep, "Bullish PB (sweep)", shape.triangleup, location.belowbar, color.new(cBull, 40), text = "PB sweep", textcolor = cBull, size = size.tiny)
plotshape(bearBreak, "Bearish PB (break)", shape.triangledown, location.abovebar, cBear, text = "PB break", textcolor = cBear, size = size.tiny)
plotshape(bearSweep, "Bearish PB (sweep)", shape.triangledown, location.abovebar, color.new(cBear, 40), text = "PB sweep", textcolor = cBear, size = size.tiny)
plotshape(showInvalid and bullBad, "Not valid (bullish)", shape.xcross, location.belowbar, color.gray, size = size.tiny)
plotshape(showInvalid and bearBad, "Not valid (bearish)", shape.xcross, location.abovebar, color.gray, size = size.tiny)

// box around the pullback candle itself (the red / green candle whose level was taken)
if showBox and bullValid
    box.new(bar_index - 1, high[1], bar_index, low[1], border_color = color.new(cBull, 30), bgcolor = color.new(cBull, 85))
if showBox and bearValid
    box.new(bar_index - 1, high[1], bar_index, low[1], border_color = color.new(cBear, 30), bgcolor = color.new(cBear, 85))

alertcondition(bullValid, "Bullish valid pullback", "Bullish valid pullback on {{ticker}} {{interval}}")
alertcondition(bearValid, "Bearish valid pullback", "Bearish valid pullback on {{ticker}} {{interval}}")
